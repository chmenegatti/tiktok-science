# === Roteiro (Google Gemini - free tier) ===
# Pegue em https://aistudio.google.com/apikey (sem cartao)
GEMINI_API_KEY=

# === Imagens de fundo ===
# "gemini" usa a mesma GEMINI_API_KEY acima (free tier, 1 chave so).
# "pollinations" = gratis sem chave, mas hoje limitado/instavel.
IMAGE_PROVIDER=gemini
# POLLINATIONS_TOKEN=        # opcional, so se usar IMAGE_PROVIDER=pollinations
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  # override opcional

# === Slides / Reel (ffmpeg) ===
# Fonte usada no texto dos slides. Ajuste para uma fonte instalada no sistema.
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Handle exibido no rodape dos slides e na caption.
IG_HANDLE=cmenegatti

# === Narracao do Reel (Edge TTS - gratis) ===
# Vozes PT-BR: pt-BR-AntonioNeural (masc), pt-BR-FranciscaNeural (fem),
#              pt-BR-ThalitaNeural, pt-BR-MacerioMultilingualNeural
TTS_VOICE=pt-BR-AntonioNeural
# TTS_RATE=+8%   # ritmo da fala (override opcional)

# === Publicacao Instagram (Graph API) ===
# Setup e obtencao das credenciais: rode `npm run auth` e siga as instrucoes.
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v21.0   # override opcional
IG_USER_ID=
IG_ACCESS_TOKEN=

# === Hospedagem das imagens (GitHub Pages) ===
# A Graph API busca os slides por URL publica. A pipeline faz commit dos PNGs
# em docs/media/ e usa esta base. Ajuste se seu Pages tiver outro dominio.
PUBLIC_BASE_URL=https://www.cesarmenegatti.com/tiktok-science
