# === Roteiro (Google Gemini - free tier) ===
# Pegue em https://aistudio.google.com/apikey (sem cartao)
GEMINI_API_KEY=

# === Imagens ===
# "gemini" usa a mesma GEMINI_API_KEY acima (free tier, 1 chave so).
# "pollinations" = gratis sem chave, mas hoje limitado/instavel.
IMAGE_PROVIDER=gemini
# POLLINATIONS_TOKEN=        # opcional, so se usar IMAGE_PROVIDER=pollinations
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation  # override opcional

# === Narracao (Edge TTS - gratis) ===
# Vozes PT-BR: pt-BR-AntonioNeural (masc), pt-BR-FranciscaNeural (fem),
#              pt-BR-ThalitaNeural, pt-BR-MacerioMultilingualNeural
TTS_VOICE=pt-BR-AntonioNeural

# === Video (ffmpeg) ===
# Fonte usada nas legendas. Ajuste para uma fonte instalada no seu sistema.
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# === Publicacao TikTok (Content Posting API) ===
# Token obtido via OAuth. Rode `npm run auth` para o fluxo de obtencao.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/callback
TIKTOK_ACCESS_TOKEN=
